{
  "name": "playwright_framework",
  "version": "1.0.0",
  "description": "A modular, scalable test automation framework built with Playwright and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:p0": "playwright test --grep @P0",
    "test:ttacart": "playwright test src/tests/ttacart",
    "test:shard": "playwright test --shard=${SHARD:-1/1}",
    "test:report": "playwright show-report",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "test:ci": "playwright test --reporter=list,json",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist test-results playwright-report tta-report allure-results allure-report",
    "rules:check": "node scripts/rule-engine.js",
    "rules:changed": "node scripts/rule-engine.js --changed",
    "rules:staged": "node scripts/rule-engine.js --staged",
    "agents:init": "npx playwright init-agents"
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "automation",
    "e2e",
    "ttacart"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.6",
    "allure-playwright": "^3.0.7",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.2.3",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  }
}
